PORT=5001
MONGODB_URI=mongodb://127.0.0.1:27017/meetify
STREAM_API_KEY=
STREAM_API_SECRET=
JWT_SECRET_KEY=

# Gmail password reset email via Nodemailer (SMTP must be allowed by the host)
CLIENT_URL=http://localhost:5173
EMAIL_USER=
# Use a Google app password, not your normal account password.
EMAIL_PASS=

# Browser push notifications (keep the private key on the backend only)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Extra allowed CORS origins, comma-separated (CLIENT_URL is always allowed)
CORS_ORIGINS=
